{
  // Checked in deliberately. Without a config in the repo, `wrangler deploy` in
  // Cloudflare's build container auto-generates one every build, so the deploy
  // settings live only in the build log and drift silently. This pins them.
  //
  // There is no Worker script — this is a pure static site, so wrangler deploys a
  // no-op worker and serves `assets.directory` directly. `_headers` at the assets
  // root is honoured (that is what sets Cross-Origin-Opener-Policy, which Google's
  // OAuth popup requires) and is NOT itself served. Exclusions live in .assetsignore.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rent-comps-tracker",
  "compatibility_date": "2026-08-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  }
}
